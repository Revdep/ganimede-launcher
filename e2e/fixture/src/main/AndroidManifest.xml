<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="Fixture" android:appCategory="news"> <!-- issue 087: the category glyph of an app with no Arcticons icon -->
        <!-- A launcher entry only so the e2e can make it a favourite; opening it shows nothing. -->
        <activity android:name=".Open" android:exported="true" android:theme="@android:style/Theme.NoDisplay"
            android:icon="@drawable/square_icon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A second launcher entry with an adaptive icon that has a monochrome layer (issue 079's monochrome fallback). -->
        <activity-alias android:name=".Mono" android:targetActivity=".Open" android:exported="true"
            android:label="Fixture mono" android:icon="@drawable/mono_icon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Behaves like phone Clock apps that accept SHOW_ALARMS only from callers holding SET_ALARM. -->
        <activity android:name=".Alarms" android:exported="true" android:label="Sveglie fixture"
            android:permission="com.android.alarm.permission.SET_ALARM">
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Stands in for TalkBack, see ScreenReader; the e2e enables it only for the clock accessibility steps. -->
        <service android:name=".ScreenReader" android:exported="false" android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_reader" />
        </service>
        <!-- Only the shell (adb) holds DUMP among ordinary senders: no app on the device can post through it. -->
        <receiver android:name=".Post" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".Media" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Not exported: only the system's grant (made for notification listeners) lets another app read it, as with chat apps. -->
        <provider android:name=".Notes" android:authorities="org.ganimede.fixture.notes"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
